APP_PORT=8080
FRONTEND_PORT=3000
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
TEMPO_PORT=3200
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-sharing

MYSQL_DATABASE=ai_resume_match
MYSQL_ROOT_PASSWORD=dev-root-password
MYSQL_USER=ai_match
MYSQL_PASSWORD=dev-mysql-password

REDIS_PASSWORD=dev-redis-password

RABBITMQ_DEFAULT_USER=ai_match
RABBITMQ_DEFAULT_PASS=dev-rabbit-password

API_TOKEN=dev-token
SESSION_SIGNING_KEY=dev-session-signing-key-change-before-sharing
SESSION_TTL=30d
SESSION_COOKIE_SECURE=false
ANALYSIS_RATE_LIMIT_ENABLED=true
ANALYSIS_RATE_LIMIT_MAX_REQUESTS=5
ANALYSIS_RATE_LIMIT_WINDOW=10m
AI_API_KEY=replace-with-your-dev-key
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
ANALYSIS_ENGINE=agent
ANALYSIS_SCHEDULING_ENABLED=true
AGENT_SERVICE_TOKEN=dev-agent-token
AGENT_SERVICE_PORT=8000
AGENT_READ_TIMEOUT=60s
AGENT_MODEL_TIMEOUT_SECONDS=45
AGENT_ANALYSIS_TIMEOUT_SECONDS=50
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_PROTOCOL_ERRORS=2
AGENT_MAX_COMPLETION_TOKENS=1200
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_MAX_CONTEXT_CHARS=100000
AGENT_MAX_CONCURRENT_ANALYSES=4
AGENT_CAPACITY_ACQUIRE_TIMEOUT_SECONDS=0.1
# Optional: configure all three from one dated/provider pricing source to enable USD estimates.
AGENT_MODEL_PRICING_VERSION=
AGENT_MODEL_INPUT_COST_USD_PER_MILLION_TOKENS=
AGENT_MODEL_OUTPUT_COST_USD_PER_MILLION_TOKENS=
# Optional distributed tracing; the observability overlay overrides both enable flags to true.
TRACING_ENABLED=false
AGENT_TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5s
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT_SECONDS=5
OTEL_SERVICE_NAME=ai-resume-match-agent
OTEL_DEPLOYMENT_ENVIRONMENT=local
RETRIEVER_MODE=hashing
EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=replace-with-your-dev-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=15
EMBEDDING_BATCH_SIZE=64
DENSE_MIN_SIMILARITY=0.35

RESUME_MAX_FILE_SIZE=5MB
RESUME_MAX_PDF_PAGES=50
RESUME_MAX_DOCX_ENTRIES=512
RESUME_MAX_DOCX_ENTRY_SIZE=10MB
RESUME_MAX_DOCX_UNCOMPRESSED_SIZE=20MB

REPORT_CACHE_TTL=10m
ANALYSIS_RUNNING_TIMEOUT=15m
ANALYSIS_RUNNING_RECOVERY_FIXED_DELAY_MS=30000
ANALYSIS_RUNNING_RECOVERY_BATCH_SIZE=20
ANALYSIS_OUTBOX_FIXED_DELAY_MS=5000
ANALYSIS_OUTBOX_BATCH_SIZE=20
ANALYSIS_OUTBOX_MAX_ATTEMPTS=10
ANALYSIS_OUTBOX_RETRY_DELAY=30s
ANALYSIS_OUTBOX_RETRY_MAX_DELAY=15m
ANALYSIS_OUTBOX_RETRY_JITTER_RATIO=0.2
ANALYSIS_OUTBOX_CONFIRM_TIMEOUT=5s
ANALYSIS_OUTBOX_LEASE_DURATION=30s
ANALYSIS_RETENTION_FIXED_DELAY_MS=3600000
ANALYSIS_RETENTION_BATCH_SIZE=200
ANALYSIS_OUTBOX_RETENTION=30d
ANALYSIS_IDEMPOTENCY_RETENTION=30d
ANALYSIS_USER_DATA_RETENTION=30d
SCHEDULER_SHUTDOWN_TIMEOUT=10s
ANALYSIS_RETRY_DELAY=1m
ANALYSIS_RETRY_MAX_DELAY=15m
ANALYSIS_RETRY_JITTER_RATIO=0.2
ANALYSIS_RETRY_SCHEDULER_FIXED_DELAY_MS=30000
ANALYSIS_RETRY_BATCH_SIZE=20
