  "info" : {
    "description" : "Asynchronous resume and job matching API",
    "title" : "AI Resume Match API",
    "version" : "v1"
  },
  "openapi" : "3.0.1",
  "paths" : {
    "/api/analysis" : {
      "get" : {
        "operationId" : "analyses",
        "parameters" : [ {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "enum" : [ "PENDING", "RUNNING", "SUCCESS", "FAILED_RETRYABLE", "FAILED_FINAL", "CANCELLED", "FAILED" ],
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalysisPageResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Invalid request"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid API token"
          }
        },
        "security" : [ {
          "apiToken" : [ ]
        } ],
        "tags" : [ "resume-match-controller" ]
      },
      "post" : {
        "operationId" : "createAnalysis",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateAnalysisRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AnalysisTaskResponse"
                }
              }
            },
            "description" : "Analysis accepted",
            "headers" : {
              "Location" : {
                "description" : "Canonical task status resource",
                "schema" : {
                  "type" : "string"
                },
                "style" : "simple"
              }
            }
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Invalid request"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Missing or invalid API token"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Anonymous session analysis quota exceeded; see Retry-After"
          },
          "503" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiProblemDetail"
                }
              }
            },
            "description" : "Analysis quota enforcement is temporarily unavailable"
          }
        },
        "security" : [ {
          "apiToken" : [ ]
        } ],
        "summary" : "Create an asynchronous analysis task from existing resources",
        "tags" : [ "resume-match-controller" ]
      }
    },
    "/api/analysis-submissions" : {
      "post" : {
        "operationId" : "createAnalysisSubmission",
        "parameters" : [ {
          "in" : "query",
          "name" : "jobTitle",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "jobContent",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : false,
          "schema" : {
            "maxLength" : 128,
            "minLength" : 0,
            "pattern" : "[A-Za-z0-9][A-Za-z0-9._:-]{0,127}",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "properties" : {
